import assert from 'node:assert/strict'
import { mkdir, mkdtemp, writeFile, rm, readFile, symlink } from 'node:fs/promises'
import { once } from 'node:events'
import type { ChildProcess } from 'node:child_process'
import path from 'node:path'
import JSZip from 'jszip'
import { avatarPng } from './image-fixture.mjs'
import { AppCore } from '../electron/core'
import { contentHash } from '../electron/books'

if (process.platform !== 'win32') throw new Error('This integration check requires Windows, WSL Ubuntu and npm run tools:reader.')
await mkdir('.test-data', { recursive: true })
const directory = await mkdtemp(path.join(path.resolve('.test-data'), 'reader-check-'))
const runtime = path.join(directory, 'native')
await mkdir(path.join(runtime, 'reader'), { recursive: true })
await symlink(path.resolve('native/tools'), path.join(runtime, 'tools'), 'junction')
await symlink(path.resolve('native/sleep-cover'), path.join(runtime, 'sleep-cover'), 'junction')
await writeFile(path.join(runtime, 'reader/bridge.lua'), await readFile('native/reader/bridge.lua', 'utf8') + '\nG_reader_settings:saveSetting("auto_suspend_timeout_seconds", 2)\n')
await writeFile(path.join(runtime, 'reader/annotations.lua'), await readFile('native/reader/annotations.lua'))
const core = new AppCore({ directory, nativeDirectory: runtime, secrets: { get: () => undefined, set: () => {} }, openBrowser: async () => {} })
try {
  await core.koreader.start()
  const resident = core.koreader as unknown as { child: ChildProcess }
  const startupPid = resident.child.pid
  assert.ok(startupPid)
  assert.equal(core.snapshot().candidates.length, 0)
  const zip = new JSZip()
  zip.file('mimetype', 'application/epub+zip', { compression: 'STORE' })
  zip.file('META-INF/container.xml', '<?xml version="1.0"?><container version="1.0" xmlns="urn:oasis:names:tc:opendocument:xmlns:container"><rootfiles><rootfile full-path="book.opf" media-type="application/oebps-package+xml"/></rootfiles></container>')
  zip.file('book.opf', '<?xml version="1.0"?><package version="2.0" xmlns="http://www.idpf.org/2007/opf" unique-identifier="id"><metadata xmlns:dc="http://purl.org/dc/elements/1.1/"><dc:identifier id="id">urn:uuid:kindlespouse-long-chapter</dc:identifier><dc:title>Original Long Chapter</dc:title><dc:creator>KindleSpouse</dc:creator><dc:language>en</dc:language></metadata><manifest><item id="chapter" href="chapter.xhtml" media-type="application/xhtml+xml"/><item id="toc" href="toc.ncx" media-type="application/x-dtbncx+xml"/></manifest><spine toc="toc"><itemref idref="chapter"/></spine></package>')
  zip.file('toc.ncx', '<?xml version="1.0"?><ncx xmlns="http://www.daisy.org/z3986/2005/ncx/" version="2005-1"><head><meta name="dtb:uid" content="urn:uuid:kindlespouse-long-chapter"/></head><docTitle><text>Original Long Chapter</text></docTitle><navMap><navPoint id="chapter" playOrder="1"><navLabel><text>Original Long Chapter</text></navLabel><content src="chapter.xhtml"/></navPoint></navMap></ncx>')
  zip.file('chapter.xhtml', '<html xmlns="http://www.w3.org/1999/xhtml"><head><title>Original Long Chapter</title></head><body><h1>Reader engine acceptance</h1>' + Array.from({ length: 500 }, (_, index) => `<p>Paragraph ${index + 1}. A long chapter must remain readable after a page turn. The desktop reader must show the actual engine output, preserve the original bytes, and wait for explicit transfer confirmation.</p>`).join('') + '</body></html>')
  const filename = path.join(directory, 'original.epub')
  const original = await zip.generateAsync({ type: 'nodebuffer' })
  await writeFile(filename, original)
  const id = await core.importFile(filename)
  const first = await core.openKoreader(id)
  assert.equal(resident.child.pid, startupPid)
  await writeFile('artifacts/native-generated-page.png', first.image)
  assert.equal(first.version, 'v2026.07.1')
  assert.equal(Buffer.from(first.image).subarray(0, 8).toString('hex'), '89504e470d0a1a0a')
  assert.equal(Buffer.from(first.image).readUInt32BE(16), 1860)
  assert.equal(Buffer.from(first.image).readUInt32BE(20), 2480)
  assert.ok(first.pages > 10)
  assert.ok(first.image.length > 10000)
  await new Promise(resolve => setTimeout(resolve, 5000))
  const next = await core.koreader.command(first.sessionId, { action: 'next' })
  assert.equal(next.page, first.page + 1)
  assert.notEqual(contentHash(first.image), contentHash(next.image))
  assert.ok(next.image.length > 10000)
  const located = await core.koreader.command(first.sessionId, { action: 'locate', anchor: { format: 'epub', quote: 'Paragraph 480.' } })
  assert.equal(located.anchorResult?.found, true)
  assert.ok(located.page > next.page)
  const repeated = await core.koreader.command(first.sessionId, { action: 'locate', anchor: { format: 'epub', quote: 'A long chapter must remain readable after a page turn.' } })
  assert.equal(repeated.anchorResult?.accuracy, 'ambiguous')
  const cover = await core.koreader.command(first.sessionId, { action: 'sleep-cover', sleepProfile: { displayName: 'Test Reader', avatar: 'TR' }, sleepStats: { duration: 2520, streak: 12 } })
  assert.notEqual(contentHash(cover.image), contentHash(located.image))
  await writeFile('artifacts/sleep-cover-runtime-fixture.png', cover.image)
  await core.saveSettings({ displayName: 'Test Reader', avatar: 'TR', avatarImage: 'data:image/png;base64,' + avatarPng().toString('base64') })
  const photoCover = await core.previewSleepCover(id)
  await writeFile('artifacts/sleep-cover-photo-runtime.png', photoCover)
  assert.notEqual(contentHash(photoCover), contentHash(cover.image))
  const cachedAt = Date.now()
  assert.equal(contentHash(await core.previewSleepCover(id)), contentHash(photoCover))
  assert.ok(Date.now() - cachedAt < 2000)
  const stillOpen = await core.koreader.command(first.sessionId, { action: 'refresh' })
  assert.equal(stillOpen.sessionId, first.sessionId)
  await core.koreader.command(first.sessionId, { action: 'page', page: next.page })
  const worker = core.koreader as unknown as { child: ChildProcess }
  const exited = once(worker.child, 'exit')
  worker.child.kill()
  await exited
  const recovered = await core.koreader.command(first.sessionId, { action: 'next' })
  assert.equal(recovered.sessionId, first.sessionId)
  assert.equal(recovered.page, next.page + 1)
  assert.equal(recovered.pages, first.pages)
  assert.ok(recovered.image.length > 10000)
  assert.equal(core.book(id).sha256, contentHash(original))
  assert.equal(core.snapshot().jobs.length, 0)
  zip.file('META-INF/container.xml', '<container><rootfiles><rootfile full-path="book.opf"/></rootfiles></container>')
  zip.file('book.opf', '<package version="3.0" xmlns="http://www.idpf.org/2007/opf"><metadata xmlns:dc="http://purl.org/dc/elements/1.1/"><dc:title>Original Long Chapter</dc:title><dc:creator>KindleSpouse</dc:creator><dc:language>en</dc:language></metadata><manifest><item id="chapter" href="chapter.xhtml" media-type="application/xhtml+xml"/></manifest><spine><itemref idref="chapter"/></spine></package>')
  zip.remove('toc.ncx')
  const invalid = path.join(directory, 'unsupported-container.epub')
  await writeFile(invalid, await zip.generateAsync({ type: 'nodebuffer' }))
  const invalidId = await core.importFile(invalid)
  await assert.rejects(core.openKoreader(invalidId), /无法显示/)
  assert.equal(core.snapshot().jobs.length, 0)
  console.log(JSON.stringify({ passed: true, actualKOReader: first.version, prestartedWithEmptyLibrary: true, startupProcessReused: true, longChapterPages: first.pages, nextPage: next.page, idleSuspendPrevented: true, recoveredPage: recovered.page, unchangedOriginal: true, noTransferBeforeApproval: true, nativeErrorPageRejected: true }))
} finally { await core.close(); await rm(directory, { recursive: true, force: true }) }
